<?xml version="1.0" encoding="utf-8"?>
<!-- SÓ-DEBUG: declara os harnesses one-off dos baselines Android do A/B visual (P7).
     AbBaselineActivity = NowPlaying (393x420); AbLibraryBaselineActivity = Library (393x600).
     Merge só no build debug; não vão p/ release. exported=true p/ o `adb shell am start`
     externo conseguir lançá-las. Sem intent-filter LAUNCHER (não aparecem na gaveta de apps;
     são lançadas explicitamente por componente). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="com.mpx.player.debug.AbBaselineActivity"
            android:exported="true" />
        <activity
            android:name="com.mpx.player.debug.AbLibraryBaselineActivity"
            android:exported="true" />
    </application>
</manifest>
